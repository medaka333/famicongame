; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="famicongame"
config/version="1.0.0"
run/main_scene="res://scenes/ui/Title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Const="*res://scripts/autoload/const.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
BulletPool="*res://scripts/autoload/bullet_pool.gd"
PixelArt="*res://scripts/autoload/pixel_art.gd"

[display]

window/size/viewport_width=256
window/size/viewport_height=240
window/size/window_width_override=1024
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

